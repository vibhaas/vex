# arrays

i32 arr[5];

arr[0] = 10;
arr[1] = 20;
arr[2] = 30; # random comment

println(arr[0]);
println(arr[1]);
println(arr[2]);

# function calls

fun add(i32 a, i32 b) -> i32 {
    return a + b;
}

fun square(i32 x) -> i32 {
    return x * x;
}

println(add(3, 4));
println(square(9));

# strings

println("hello");
println("line1\nline2");
println("tab\tseparated");
println("\"quoted\"");
println("backslash \\");